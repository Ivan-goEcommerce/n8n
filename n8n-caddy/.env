# Auf dem Server: cp .env.example .env && nano .env

# Pflicht: E-Mail für Let's Encrypt (Zertifikatshinweise)
ACME_EMAIL=admin@goecloud.eu

# Domain und öffentliche URL (Standard passt zu goproton8n.goecloud.eu)
N8N_HOST=goproton8n.goecloud.eu
WEBHOOK_URL=https://goproton8n.goecloud.eu/

# Pflicht: einmal generieren und dauerhaft behalten (niemals ändern nach Nutzung)
# Beispiel: openssl rand -base64 32
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin
